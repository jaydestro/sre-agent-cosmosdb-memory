# Existing resources only; no application startup provisioning.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SCOPE_ID=demo-payments-development
SERVICE_ID=payments
ALLOW_AZURE_USE=false
ALLOW_DEMO_RESET=false
COSMOS_ENDPOINT=
COSMOS_DATABASE=incident-memory
COSMOS_AUTH_MODE=entra
# Explicit key mode only. Never commit a real key.
COSMOS_KEY=
COSMOS_OPERATIONS_CONTAINER=operations
COSMOS_EVIDENCE_CONTAINER=evidence
COSMOS_MEMORY_CONTAINER=agent-memory
FOUNDRY_ENDPOINT=
REASONING_DEPLOYMENT=
MEMORY_DEPLOYMENT=
MEMORY_EMBEDDING_DEPLOYMENT=
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=microsoft-embedding-1-large
EMBEDDING_DIMENSIONS=1536
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOKENS=4096
EVIDENCE_TOP_K=5
MEMORY_TOP_K=5
APPROVAL_EXPIRATION_SECONDS=300
MONITOR_INTERVAL_SECONDS=10
OPERATOR_TENANT_ID=
OPERATOR_AUDIENCE=
OPERATOR_MEMBERSHIPS_JSON={}
LOCAL_OPERATOR_ID=engineer-a
LOCAL_ADMIN_IDS=["engineer-a"]
# ONLY enable with Container Apps Entra auth enforced and direct ingress blocked.
# The ingress must strip caller-supplied X-MS-* headers. OID/TID/AUD are checked
# against this server-owned configuration, not caller-provided role/scope claims.
TRUSTED_AUTH_PROXY=false
